# ── JonArt Galleries — Environment Variables ──
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# Supabase (get from supabase.com > project settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Resend email (get from resend.com)
RESEND_API_KEY=re_your_key_here

# Your details
ADMIN_EMAIL=hello@jonartgalleries.com
ADMIN_DASHBOARD_URL=https://supabase.com/dashboard/project/your-project/editor

# Frontend URL (your Vercel deployment)
FRONTEND_URL=https://jonartgalleries.vercel.app

# Port (Railway/Render set this automatically)
PORT=3000
